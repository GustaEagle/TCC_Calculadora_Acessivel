# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# KiCad — histórico local (backup automático); preferir commits do projeto + pasta snapshots/ para marcos
**/.history/
*-backups/
fp-info-cache

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Build / imagem (ajustar quando system/ tiver receitas)
system/**/build/
system/**/output/
system/**/dist/
# Imagem Alpine (system/rpi-os/alpine/build-alpine-img.sh): diretório de trabalho
# (rootfs, downloads, mount) e o .img gerado nunca são versionados.
system/rpi-os/alpine/.work/
*.img
*.img.gz

# Logs temporários
*.log

# Cópia local da partição boot (firmware/binários Raspberry Pi); regenerar a partir da imagem oficial ou de system/
bootfoverlay/
