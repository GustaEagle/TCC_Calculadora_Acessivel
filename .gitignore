# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# KiCad — histórico local (backup automático); preferir commits do projeto + pasta snapshots/ para marcos
**/.history/
*-backups/
fp-info-cache

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Build / imagem (ajustar quando system/ tiver receitas)
system/**/build/
system/**/output/
system/**/dist/
# Imagem Alpine (system/rpi-os/alpine/build-alpine-img.sh): diretório de trabalho
# (rootfs, downloads, mount) e o .img gerado nunca são versionados.
system/rpi-os/alpine/.work/
*.img
*.img.gz

# Logs temporários
*.log
data/

# Cópia local da partição boot (firmware/binários Raspberry Pi); regenerar a partir da imagem oficial ou de system/
bootfoverlay/

# Configuracao local do Claude Code (especifica da maquina)
.claude/settings.local.json

# Wheel musl/aarch64 do Piper (~34 MB), compilado por scripts/build-piper-wheel.sh.
# Artefato de build reproduzível (`make piper-wheel`), tratado como o .img: fica
# fora do git. O README da pasta é versionado e explica o porquê.
system/rpi-os/alpine/wheels/*.whl
